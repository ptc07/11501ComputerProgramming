total = 0

for i in range(1, 11):
    total += i

print(total)



def recursive_sum(n):
    if n == 1: # 終止條件（Base Case）
        return 1
    return n + recursive_sum(n - 1) 

print(recursive_sum(10)) 



from functools import reduce

result = reduce(lambda x, y: x + y,range(1, 11))
print(result) 